# Maintainer: win0na <winona@winneon.moe>
pkgname=apw-cli
pkgver=0.4.0
pkgrel=1
pkgdesc='Read Apple Passwords on Linux'
arch=('x86_64' 'aarch64')
url='https://github.com/win0na/apw'
license=('GPL-3.0-only')
depends=('gcc-libs' 'glibc' 'dbus')
conflicts=('apw')
provides=('apw')
makedepends=('cargo' 'rust' 'dbus' 'zig')
source=("git+$url.git#tag=v$pkgver")
sha256sums=('SKIP')

build() {
  cd apw
  git submodule update --init --recursive
  # No --frozen: the crates are not vendored, so cargo fetches them here.
  cargo build --release --locked
}

check() {
  cd apw
  # build() does not fetch dev-dependencies, so this cannot be offline.
  cargo test --locked
}

package() {
  cd apw
  case "$CARCH" in
    x86_64) lib_platform=x86_64-linux ;;
    aarch64) lib_platform=aarch64-linux ;;
    *) echo "error: no OpenTUI library for $CARCH" >&2; exit 1 ;;
  esac

  install -Dm755 "target/release/apw" "$pkgdir/usr/bin/apw"
  # The executable finds this at $ORIGIN/../lib/apw.
  install -Dm755 "${OPENTUI_LIB_DIR:-opentui/packages/native/lib/$lib_platform}/libopentui.so" \
    "$pkgdir/usr/lib/apw/libopentui.so"
  strip --strip-unneeded "$pkgdir/usr/lib/apw/libopentui.so"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -d "$pkgdir/usr/share/doc/$pkgname/docs"
  install -m644 docs/*.md "$pkgdir/usr/share/doc/$pkgname/docs/"
}
