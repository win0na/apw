[Unit]
Description=Anisette device identity service for apw
Documentation=https://github.com/win0na/apw/blob/main/docs/install.md

[Service]
ExecStartPre=@ANISETTE@ --check --backend macos
ExecStart=@ANISETTE@ --backend windows --listen 127.0.0.1:6969 --state-dir %S/anisette
StateDirectory=anisette
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
